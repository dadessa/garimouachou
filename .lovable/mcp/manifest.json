        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null,
        "conditional": true
      },
      {
        "name": "rank_opportunities",
        "title": "Ranking de oportunidades",
        "description": "Ranking do Radar (mesmo score da tela) com visão e filtros; ofertas vencidas ficam de fora.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "view": {
              "type": "string",
              "enum": [
                "melhores",
                "crescimento",
                "vendidos",
                "procurados",
                "comissao",
                "extra",
                "sazonais",
                "financeiro",
                "novos"
              ]
            },
            "marketplace": {
              "type": "string",
              "maxLength": 30
            },
            "category": {
              "type": "string",
              "maxLength": 60
            },
            "keyword": {
              "type": "string",
              "maxLength": 60
            },
            "max_price_reais": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            },
            "min_commission_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "only_new": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null,
        "conditional": true
      },
      {
        "name": "get_best_sellers",
        "title": "Mais vendidos",
        "description": "Oportunidades com mais vendas informadas pela loja (vendas, não buscas).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "marketplace": {
              "description": "Slug da loja, ex.: shopee.",
              "type": "string",
              "maxLength": 30
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null,
        "conditional": true
      },
      {
        "name": "get_commission_rates",
        "title": "Maiores comissões",
