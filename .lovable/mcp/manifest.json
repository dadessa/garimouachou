        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null,
        "conditional": true
      },
      {
        "name": "get_analytics",
        "title": "Desempenho do site",
        "description": "Relatório de desempenho dos últimos N dias (cliques não são vendas).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
