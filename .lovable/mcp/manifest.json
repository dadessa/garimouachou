{
  "version": 1,
  "sdk_version": "3.6.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://bnzhohvobucksorgyetc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "garimou-achou",
      "version": "0.2.0",
      "title": "Garimou Achou"
    },
    "tools": [
      {
        "name": "search_products",
        "title": "Buscar achados",
        "description": "Busca produtos publicados no Garimou Achou! por nome, com filtro opcional de categoria ou loja (slug).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "description": "Texto para buscar no nome do produto.",
              "type": "string",
              "maxLength": 100
            },
            "category": {
              "description": "Slug da categoria.",
              "type": "string",
              "maxLength": 60
            },
            "marketplace": {
              "description": "Slug da loja (amazon, shopee, mercadolivre, magalu).",
              "type": "string",
              "maxLength": 60
            },
            "limit": {
              "description": "Máximo de resultados (padrão 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_categories",
        "title": "Listar categorias",
        "description": "Lista as categorias ativas do Garimou Achou!.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
