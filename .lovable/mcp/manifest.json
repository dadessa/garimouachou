        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "marketplace": {
              "description": "Slug da loja, ex.: shopee.",
              "type": "string",
              "maxLength": 30
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null,
        "conditional": true
      },
      {
        "name": "get_market_trends",
        "title": "Tendências",
        "description": "Pesquisa externa real de mais vendidos nas lojas conectadas, mais tendências do Radar e buscas do site.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
