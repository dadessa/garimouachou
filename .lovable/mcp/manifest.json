      {
        "name": "check_expired_offers",
        "title": "Ofertas vencidas",
        "description": "Lista oportunidades com dados vencidos.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null,
        "conditional": true
      },
      {
        "name": "prepare_import",
        "title": "Preparar importação",
        "description": "Gera prévia e um token de aprovação (15 min, uso único) para incluir oportunidades. Não cadastra nada.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "opportunity_ids": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "publish": {
              "type": "boolean"
            }
          },
          "required": [
            "opportunity_ids"
          ],
          "additionalProperties": false
        },
        "outputSchema": null,
        "conditional": true
      },
      {
        "name": "confirm_import",
        "title": "Confirmar importação",
        "description": "Confirma uma importação preparada. Use SOMENTE depois que a administradora aprovar explicitamente a prévia.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "minLength": 20,
              "maxLength": 100
            }
          },
          "required": [
            "token"
          ],
          "additionalProperties": false
        },
        "outputSchema": null,
        "conditional": true
      },
      {
        "name": "generate_campaign",
        "title": "Gerar campanha",
        "description": "Gera legendas, textos de WhatsApp, roteiros, stories, hashtags, links UTM e calendário. Nada é publicado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "product_ids": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "theme": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": [
            "product_ids"
          ],
          "additionalProperties": false
        },
        "outputSchema": null,
        "conditional": true
      },
      {
        "name": "daily_sales_plan",
        "title": "Plano diário",
        "description": "Plano de divulgação do dia com dados reais do Radar e do catálogo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
